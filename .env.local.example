# The setup the demo ran on. Copy to .env and fill in the four API keys (OpenCode, OpenRouter, Groq, ElevenLabs).
# See "Provider setup used" in the README for where to create each key and the ElevenLabs voice id.

AI_PROVIDER=openai_compatible
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_AUTH_MODE=bearer
LLM_API_KEY=
LLM_HEADERS='{"x-opencode-session":"northstar"}'
LLM_OUTPUT_MODE=prompt_json

# All RAG fields blank = inherit complete LLM profile.
# Set all required RAG fields to use a separate answer server/model.
RAG_BASE_URL=
RAG_MODEL=
RAG_AUTH_MODE=
RAG_API_KEY=
RAG_OUTPUT_MODE=

# Semantic retrieval through OpenRouter.
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
EMBED_AUTH_MODE=bearer
EMBED_API_KEY=
EMBED_MIN_SIMILARITY=

STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_AUTH_MODE=bearer
STT_API_KEY=

TTS_BASE_URL=https://api.elevenlabs.io/v1
TTS_MODEL=eleven_multilingual_v2
TTS_AUTH_MODE=elevenlabs
TTS_API_KEY=
TTS_VOICE=AivOXtevERua54v2RaMU
TTS_AUDIO_FORMAT=mp3
TTS_MAX_INPUT_CHARS=4000

# Shared request concurrency across model services.
PROVIDER_MAX_CONCURRENCY=4

# Container networking; keep APP_PORT consistent with the health-check URL.
APP_PUBLISH_HOST=127.0.0.1
APP_PUBLISH_PORT=8000
APP_BIND_HOST=0.0.0.0
APP_PORT=8000
APP_HEALTH_URL=http://127.0.0.1:${APP_PORT}/health
MODEL_HOST_ALIAS=host.docker.internal
MODEL_HOST_GATEWAY=host-gateway
LLM_REASONING_EFFORT=none

# Spanish voice (ElevenLabs)
TTS_ES_BASE_URL=https://api.elevenlabs.io/v1
TTS_ES_MODEL=eleven_multilingual_v2
TTS_ES_AUTH_MODE=elevenlabs
TTS_ES_API_KEY=
TTS_ES_VOICE=AivOXtevERua54v2RaMU
TTS_ES_AUDIO_FORMAT=mp3
TTS_ES_MAX_INPUT_CHARS=4000
