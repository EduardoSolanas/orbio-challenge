import shutil
from pathlib import Path
source=Path('/work');target=Path('/tmp/orbio-followup-check')
shutil.copytree(source,target,ignore=shutil.ignore_patterns('mutants','reports','__pycache__','.pytest_cache'))
(target/'reports').mkdir()
shutil.copyfile(source/'deadline-test.py',target/'tests/unit/gateway/providers/test_extract_json.py')
shutil.copyfile(source/'followup-flow-tests.py',target/'tests/integration/order_verification/test_flows_in_context.py')
p=target/'pyproject.toml';text=p.read_text();before='pytest_add_cli_args_test_selection = ["tests/unit", "tests/integration"]';after='pytest_add_cli_args_test_selection = ["tests/unit/gateway/providers/test_extract_json.py", "tests/integration/order_verification/test_flows_in_context.py"]';assert before in text;p.write_text(text.replace(before,after))
