#!/bin/sh
cd /tmp/orbio-deadline-check
python -m pytest tests/unit/gateway/providers/test_extract_json.py -q > /work/reports/deadline-baseline.txt 2>&1 || exit $?
python -m mutmut run gateway.providers.wire.x_extract_json__mutmut_21 gateway.providers.wire.x_extract_json__mutmut_22 gateway.providers.wire.x_extract_json__mutmut_31 gateway.providers.wire.x_extract_json__mutmut_33 --max-children 4 > /work/reports/deadline-mutation-run.txt 2>&1
result=$?
printf '%s\n' "$result" > /work/reports/deadline-mutation-exit-code
python -m mutmut results --all true > /work/reports/deadline-all-results.txt 2>&1
exit "$result"
