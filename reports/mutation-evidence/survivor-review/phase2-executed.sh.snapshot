#!/bin/sh
cd /tmp/orbio-phase2
python -m pytest tests/unit/gateway/conversation/test_survivor_regressions.py -q > /work/reports/phase2-baseline.txt 2>&1
baseline=$?
printf '%s\n' "$baseline" > /work/reports/phase2-baseline-exit-code
if [ "$baseline" -ne 0 ]; then exit "$baseline"; fi
python -m mutmut run 'gateway.conversation.engine.xǁConversationEngineǁ_answer_policy_question__mutmut_43' 'gateway.conversation.flows.x_load_flows__mutmut_6' 'gateway.conversation.flows.x_load_flows__mutmut_61' --max-children 2 > /work/reports/phase2-run.txt 2>&1
result=$?
printf '%s\n' "$result" > /work/reports/phase2-exit-code
python -m mutmut results --all true > /work/reports/phase2-all-results.txt 2>&1
exit "$result"
