# Example addresses/model IDs only: provision servers and set their served IDs.
AI_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_MODEL=your-extraction-model
LLM_AUTH_MODE=none
LLM_API_KEY=
LLM_OUTPUT_MODE=json_schema

# All RAG fields blank = inherit complete LLM profile.
# Set all required RAG fields to use a separate answer server/model.
RAG_BASE_URL=
RAG_MODEL=
RAG_AUTH_MODE=
RAG_API_KEY=
RAG_OUTPUT_MODE=

STT_BASE_URL=http://host.docker.internal:8002/v1
STT_MODEL=your-transcription-model
STT_AUTH_MODE=none
STT_API_KEY=

TTS_BASE_URL=http://host.docker.internal:8003/v1
TTS_MODEL=your-speech-model
TTS_AUTH_MODE=none
TTS_API_KEY=
TTS_VOICE=your-supported-voice

# Private Order API boundary. The gateway and the order-api container share this
# token; generate a long random value locally. Never expose it to the browser.
# Compose sets ORDER_API_URL=http://order-api:8001 for the gateway service.
ORDER_API_URL=http://order-api:8001
ORDER_API_TOKEN=replace-with-a-long-random-value
ORDER_API_TIMEOUT_SECONDS=5
