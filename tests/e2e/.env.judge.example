# Dedicated local Spark/OpenAI-compatible intent judge configuration.
# Copy to .env.judge and set the exact model ID. This example has no secrets.
E2E_JUDGE_BASE_URL=http://127.0.0.1:8888/v1
E2E_JUDGE_MODEL=replace-with-exact-local-model-id
# A reasoning model spends most of these tokens thinking (about 3000 for a booking rule);
# too small a limit returns an empty answer. The loader allows up to 120 s and 4096 tokens.
E2E_JUDGE_TIMEOUT_SECONDS=120
E2E_JUDGE_MAX_TOKENS=4096
E2E_JUDGE_TEMPERATURE=0
E2E_JUDGE_PROMPT_VERSION=intent-judge-v2
# Optional: ask a reasoning judge to think less (none, minimal, low, medium, high, xhigh, max),
# which cuts both the token use and the time per verdict if the server honours it. Blank omits it.
E2E_JUDGE_REASONING_EFFORT=
