# Example addresses/model IDs only: provision servers and set their served IDs.
AI_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_MODEL=your-extraction-model
LLM_AUTH_MODE=none
LLM_API_KEY=
LLM_OUTPUT_MODE=json_schema
# Optional server-supported reasoning level; use none to avoid hidden reasoning
# token usage on models that default to extended reasoning. Blank omits the field.
LLM_REASONING_EFFORT=

# All RAG fields blank = inherit complete LLM profile.
# Set all required RAG fields to use a separate answer server/model.
RAG_BASE_URL=
RAG_MODEL=
RAG_AUTH_MODE=
RAG_API_KEY=
RAG_OUTPUT_MODE=
RAG_REASONING_EFFORT=

STT_BASE_URL=http://host.docker.internal:8002/v1
STT_MODEL=your-transcription-model
STT_AUTH_MODE=none
STT_API_KEY=

TTS_BASE_URL=http://host.docker.internal:8003/v1
TTS_MODEL=your-speech-model
TTS_AUTH_MODE=none
TTS_API_KEY=
TTS_VOICE=your-supported-voice
# mp3 (default) or wav; Groq Orpheus requires wav.
TTS_AUDIO_FORMAT=mp3
# Per-request provider limit (1-4000). Groq Orpheus requires 200; WAV replies
# are split into ordered chunks and assembled. MP3 profiles require 4000.
TTS_MAX_INPUT_CHARS=4000

# Shared request concurrency across model services.
PROVIDER_MAX_CONCURRENCY=4

# Private Order API. Compose overrides this with http://order-api:8001 for the
# internal network; a non-Compose local run must point at the Order API origin.
ORDER_API_BASE_URL=http://127.0.0.1:8001
# Bounded per-request timeout for the gateway-to-Order-API boundary (max 60).
ORDER_API_TIMEOUT_SECONDS=5

# Container networking; keep APP_PORT consistent with the health-check URL.
APP_PUBLISH_HOST=127.0.0.1
APP_PUBLISH_PORT=8000
APP_BIND_HOST=0.0.0.0
APP_PORT=8000
APP_HEALTH_URL=http://127.0.0.1:${APP_PORT}/health
MODEL_HOST_ALIAS=host.docker.internal
MODEL_HOST_GATEWAY=host-gateway
